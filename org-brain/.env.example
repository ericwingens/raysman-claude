# ─── Org Brain environment ───────────────────────────────────────────────────
# Everything is OPTIONAL. With no keys set, the app runs against the bundled
# local seed (src/data/seed.json) and the copilot returns a deterministic
# offline answer, so you can demo the graph + @-mention UX immediately.
# Fill these in to switch on the real Supabase + Voyage + Claude backend.

# ── Supabase (Postgres + pgvector) ──
# Use an EU region (e.g. eu-central-1 / Frankfurt) for GDPR/BDSG reasons.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key is server-only; never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (Claude — the copilot LLM) ──
ANTHROPIC_API_KEY=
# Versioned, pinned model strings (never alias strings) per Anthropic guidance.
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_PLANNING_MODEL=claude-opus-4-8

# ── Voyage AI (embeddings — Anthropic ships no first-party embedder) ──
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
VOYAGE_DIMENSIONS=1024

# ── Optional agent tool integrations ──
ASANA_ACCESS_TOKEN=
APOLLO_API_KEY=
